rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper to get user record
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // A signed-in staff account that exists and is not disabled. A disabled
    // account is cut off from all data immediately, even with an open session.
    // Student portal sessions (custom tokens) are never staff accounts.
    function isPortalSession() {
      return request.auth != null && request.auth.token.get('portal', '') == 'student';
    }

    function isActiveAccount() {
      return isSignedIn()
        && !isPortalSession()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().get('disabled', false) != true;
    }

    // Accounts that are promoted to admin automatically on login (same list as
    // ADMIN_EMAILS in services/firestore.ts).
    function isDefaultAdminEmail() {
      return request.auth.token.get('email', '') in ['saber.gd.fl@gmail.com', 'sabergroup.eg@gmail.com'];
    }

    // Helper for roles
    function hasRole(role) {
      return isActiveAccount() && getUserData().role == role;
    }
    
    function isStaff() {
      return hasRole('admin') || hasRole('coordinator') || hasRole('team_leader') || hasRole('supervisor');
    }

    function isTrainer() {
      return hasRole('trainer');
    }

    function isGroupTrainer(groupId) {
      return isTrainer()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.primaryTrainerId == request.auth.uid
          || (
            get(/databases/$(database)/documents/groups/$(groupId)).data.keys().hasAny(['trainerIds'])
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.trainerIds
          )
        );
    }

    function canTrainerUpdateSessionLinks() {
      return isSignedIn()
        && isGroupTrainer(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lectureRecordingUrl',
          'tasksMessageUrl',
          'requiredTasksCount'
        ]);
    }

    // Any trainer may add an extra (upcoming) lecture to a group
    function canTrainerAddExtraSession() {
      return isSignedIn()
        && isTrainer()
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && request.resource.data.isExtra == true
        && request.resource.data.status == 'upcoming';
    }

    // ...and bump the group's lecture count accordingly (increase only)
    function canTrainerIncreaseTotalSessions() {
      return isSignedIn()
        && isTrainer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalSessions'])
        && request.resource.data.totalSessions is int
        && request.resource.data.totalSessions > resource.data.get('totalSessions', 0);
    }

    // Users collection
    // Booking price / paid amounts from the accounting sync (Cloud Function
    // only). Management only (not trainers), behind the "sensitive data" toggle.
    match /studentFinancials/{studentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /users/{userId} {
      // Readable by any signed-in account so the app can load a disabled
      // profile and show the "account disabled" message.
      allow read: if isSignedIn() && !isPortalSession();
      allow write: if isStaff();
      // First login creates the own profile (getOrCreateUser): trainer, or admin
      // for the default admin emails, never pre-disabled.
      allow create: if isSignedIn() && !isPortalSession() && request.auth.uid == userId
        && request.resource.data.get('disabled', false) == false
        && (request.resource.data.role == 'trainer'
            || (request.resource.data.role == 'admin' && isDefaultAdminEmail()));
      // Own profile: only the forced password change flags, plus the automatic
      // admin promotion of the default admin emails. role/disabled stay locked.
      allow update: if isActiveAccount() && request.auth.uid == userId
        && resource.data.get('disabled', false) != true
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt', 'updatedAt'])
          || (isDefaultAdminEmail()
              && request.resource.data.role == 'admin'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']))
        );
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isStaff();
      allow update: if canTrainerIncreaseTotalSessions();
    }

    // Students collection. Holds credentials and contact data, so it is no
    // longer public: staff accounts, or the student portal session of the
    // student themself (custom token from the studentPortal function, claim
    // `sidn` = the student's unified studentIdNum).
    function isPortalStudentFor(data) {
      return request.auth != null
        && request.auth.token.get('portal', '') == 'student'
        && data.get('studentIdNum', null) == request.auth.token.get('sidn', '');
    }

    match /students/{studentId} {
      allow read: if isActiveAccount() || isPortalStudentFor(resource.data);
      allow create, delete: if isActiveAccount();
      allow update: if isActiveAccount()
        || (isPortalStudentFor(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'phone', 'whatsappLink', 'email', 'profileEditedFields', 'profileEditHistory',
              'hasLoggedIn', 'lastLoginAt', 'loginCount', 'firstLoginAt'
            ]));
    }

    // Enrollments collection
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Evaluation Forms collection
    match /global_eval_forms/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isStaff() || canTrainerAddExtraSession();
      allow delete: if isStaff();
      allow update: if isStaff() || canTrainerUpdateSessionLinks();
    }

    // Weekly Schedules, Weeks & Items
    match /weeks/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }
    
    match /weekDays/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }
    
    match /scheduleItems/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff() || (isActiveAccount() && request.resource.data.trainerId == request.auth.uid);
    }

    // Daily Ops
    match /dailyTrainerOps/{id} {
      allow read: if isStaff() || (isActiveAccount() && id.matches(request.auth.uid + '_.*'));
      allow write: if isActiveAccount() && id.matches(request.auth.uid + '_.*');
    }

    // Session Meta
    match /sessionMeta/{id} {
      allow read: if true;
      allow write: if isActiveAccount();
    }

    // Evaluation & Ranking collections
    match /lectureEvaluations/{id} {
      allow read: if true;
      allow write: if true; 
    }
    
    match /groupRankings/{id} {
      allow read: if true;
      allow write: if true;
    }
    
    match /finalProjects/{id} {
      allow read: if true;
      allow write: if true;
    }
    
    match /penalties/{id} {
      allow read: if true;
      allow write: if true;
    }
    
    match /attendance/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Marketing Resources
    match /marketingResources/{id} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    match /marketingCategories/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    match /marketingSectionTemplates/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    // Activity Logs
    match /activityLogs/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Role Permissions
    match /rolePermissions/{role} {
      allow read: if true;
      allow write: if true;
    }

    // Assigned Tasks
    match /assignedTasks/{taskId} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    // Recurring Task Templates
    match /recurringDailyTemplates/{templateId} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    // Trainer Daily Reports
    match /trainerDailyReports/{reportId} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    // Performance Reports (Daily & Weekly)
    match /dailyReports/{reportId} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    match /weeklyReports/{reportId} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    // Student Follow Ups
    match /studentFollowUps/{id} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    // Per-person follow-up mention tasks (independent of the follow-up's own status)
    match /followUpMentions/{id} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    // Rejected follow-up suggestions (cooldown before they can reappear)
    match /followUpSuggestionRejections/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    // Permanent, reason-scoped follow-up suggestion exemptions
    match /followUpSuggestionExemptions/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    // Suggestion decisions escalated to admin (e.g. remove a student entirely)
    match /suggestionEscalations/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    // Student Weakness Points
    match /studentWeaknesses/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Student Certificates
    match /studentCertificates/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Label Definitions
    match /labelDefinitions/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    // Complaints
    match /complaints/{id} {
      allow read: if isActiveAccount();
      allow write: if isActiveAccount();
    }

    // Notifications
    match /notifications/{id} {
      allow read: if isActiveAccount() && resource.data.userId == request.auth.uid;
      allow write: if isActiveAccount(); // System or other users can send notifications
    }

    // Trainer Plans
    match /trainerPlans/{id} {
      allow read, write: if isActiveAccount();
    }

    // Group Execution Plans
    match /groupExecutionPlans/{id} {
      allow read: if true;
      allow write: if isActiveAccount();
    }
    
    // Meta (Migrations)
    match /meta/{id} {
      allow read: if isActiveAccount();
      allow write: if isStaff();
    }

    // Global Settings
    match /settings/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Google Connections
    match /googleConnections/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Email Logs
    match /emailLogs/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Google Audit Logs
    match /googleAuditLogs/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Reschedule Logs
    match /rescheduleLogs/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Email Templates
    match /emailTemplates/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Graduation Projects collections
    match /graduationProjects/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /graduationSubmissions/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /graduationEvaluations/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /graduationComments/{id} {
      allow read: if true;
      allow write: if true;
    }
  }
}
