{
 "total": 121.011,
 "scenes": [
  {
   "id": 1,
   "start": 0.0,
   "dur": 5.016,
   "voStart": 0.5,
   "voDur": 3.616,
   "subs": [
    {
     "start": 0.5,
     "end": 2.414,
     "text": "كام مرة دخلت كورس…"
    },
    {
     "start": 2.414,
     "end": 4.116,
     "text": "وحسيت إنك لوحدك؟"
    }
   ]
  },
  {
   "id": 2,
   "start": 5.016,
   "dur": 8.843,
   "voStart": 5.516,
   "voDur": 7.443,
   "subs": [
    {
     "start": 5.516,
     "end": 8.213,
     "text": "محاضرة تفوتك، تاسك يتأجل،"
    },
    {
     "start": 8.213,
     "end": 10.262,
     "text": "سؤال محدش يرد عليه…"
    },
    {
     "start": 10.262,
     "end": 12.959,
     "text": "ومحدش واخد باله إنك بتقع."
    }
   ]
  },
  {
   "id": 3,
   "start": 13.859,
   "dur": 7.674,
   "voStart": 14.359,
   "voDur": 5.474,
   "subs": [
    {
     "start": 14.359,
     "end": 17.686,
     "text": "في صابر جروب، القصة دي مبتحصلش."
    },
    {
     "start": 17.686,
     "end": 19.833,
     "text": "لأنك مش هتمشي لوحدك."
    }
   ]
  },
  {
   "id": 4,
   "start": 21.533,
   "dur": 9.369,
   "voStart": 22.033,
   "voDur": 7.969,
   "subs": [
    {
     "start": 22.033,
     "end": 24.199,
     "text": "من أول دقيقة في المحاضرة،"
    },
    {
     "start": 24.199,
     "end": 26.277,
     "text": "السيستم شغال: وقت الشرح،"
    },
    {
     "start": 26.277,
     "end": 28.01,
     "text": "ووقت التطبيق العملي،"
    },
    {
     "start": 28.01,
     "end": 30.002,
     "text": "وكل حاجة اتشرحت بتتسجل."
    }
   ]
  },
  {
   "id": 5,
   "start": 30.902,
   "dur": 11.561,
   "voStart": 31.402,
   "voDur": 10.161,
   "subs": [
    {
     "start": 31.402,
     "end": 34.224,
     "text": "حضرت؟ حضورك بيتسجل لوحده."
    },
    {
     "start": 34.224,
     "end": 35.918,
     "text": "غبت؟ مش هتتنسي…"
    },
    {
     "start": 35.918,
     "end": 41.563,
     "text": "هيوصلك تسجيل المحاضرة والتاسك عشان تلحق اللي فاتك."
    }
   ]
  },
  {
   "id": 6,
   "start": 42.463,
   "dur": 14.994,
   "voStart": 42.963,
   "voDur": 13.594,
   "subs": [
    {
     "start": 42.963,
     "end": 44.621,
     "text": "وبعد كل محاضرة،"
    },
    {
     "start": 44.621,
     "end": 47.384,
     "text": "المدرب بيقيمك إنت بالاسم:"
    },
    {
     "start": 47.384,
     "end": 48.931,
     "text": "حضورك، تسليمك،"
    },
    {
     "start": 48.931,
     "end": 52.026,
     "text": "جودة شغلك. ولو فيه نقطة ضعف،"
    },
    {
     "start": 52.026,
     "end": 56.557,
     "text": "بيكتبهالك، ويفضل وراك لحد ما تتغلب عليها."
    }
   ]
  },
  {
   "id": 7,
   "start": 57.457,
   "dur": 14.699,
   "voStart": 57.957,
   "voDur": 13.299,
   "subs": [
    {
     "start": 57.957,
     "end": 62.449,
     "text": "ولو بدأت تقع؟ السيستم بيلاحظ قبل ما إنت نفسك تلاحظ."
    },
    {
     "start": 62.449,
     "end": 66.589,
     "text": "أول ما حضورك أو تاسكاتك تنزل عن سبعين في المية،"
    },
    {
     "start": 66.589,
     "end": 68.438,
     "text": "فريق المتابعة بيكلمك،"
    },
    {
     "start": 68.438,
     "end": 71.256,
     "text": "ويفهم مشكلتك، ويرجعك على الطريق."
    }
   ]
  },
  {
   "id": 8,
   "start": 72.156,
   "dur": 16.013,
   "voStart": 72.656,
   "voDur": 14.613,
   "subs": [
    {
     "start": 72.656,
     "end": 76.062,
     "text": "وكل ده قدامك، في بوابتك الخاصة."
    },
    {
     "start": 76.062,
     "end": 77.711,
     "text": "محاضرتك الجاية،"
    },
    {
     "start": 77.711,
     "end": 79.908,
     "text": "ونقاطك، ونسبة حضورك،"
    },
    {
     "start": 79.908,
     "end": 81.776,
     "text": "وتسجيل كل محاضرة،"
    },
    {
     "start": 81.776,
     "end": 83.424,
     "text": "وتقييم كل تاسك،"
    },
    {
     "start": 83.424,
     "end": 85.951,
     "text": "وملاحظات مدربك ليك إنت…"
    },
    {
     "start": 85.951,
     "end": 87.269,
     "text": "كله في جيبك."
    }
   ]
  },
  {
   "id": 9,
   "start": 88.169,
   "dur": 17.025,
   "voStart": 88.669,
   "voDur": 14.425,
   "subs": [
    {
     "start": 88.669,
     "end": 91.055,
     "text": "وهدفك واضح من أول يوم:"
    },
    {
     "start": 91.055,
     "end": 93.116,
     "text": "شروط الشهادة قدامك،"
    },
    {
     "start": 93.116,
     "end": 96.153,
     "text": "وشايف نسبتك فيها لحظة بلحظة."
    },
    {
     "start": 96.153,
     "end": 97.997,
     "text": "تسلم مشروع تخرجك،"
    },
    {
     "start": 97.997,
     "end": 100.275,
     "text": "يتقيم بمعايير حقيقية،"
    },
    {
     "start": 100.275,
     "end": 103.095,
     "text": "ولما تخلص… شهادتك مستنياك."
    }
   ]
  },
  {
   "id": 10,
   "start": 105.195,
   "dur": 15.816,
   "voStart": 105.695,
   "voDur": 11.416,
   "subs": [
    {
     "start": 105.695,
     "end": 109.285,
     "text": "في صابر جروب، إحنا مش بنديك كورس وخلاص."
    },
    {
     "start": 109.285,
     "end": 112.692,
     "text": "إحنا معاك، من أول محاضرة لحد الشهادة."
    },
    {
     "start": 112.692,
     "end": 117.111,
     "text": "احجز مكانك دلوقتي على صابر جروب أكاديمي دوت كوم."
    }
   ]
  }
 ]
}